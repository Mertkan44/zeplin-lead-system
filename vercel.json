{
  "version": 2,
  "functions": {
    "api/*.py": {
      "excludeFiles": "{.git/**,.cache/**,venv/**,__pycache__/**,docs/**,mockup.html,public/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
