AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek is OpenAI-compatible. Set AI_PROVIDER=deepseek to use it.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_INPUT_PRICE_PER_MILLION=0.28
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0.42
SALES_SENDER_NAME=Zeplin Media

# Google Places API (New), server-side only. Restrict the key to Places API.
GOOGLE_PLACES_API_KEY=
PLACES_REFRESH_BATCH_SIZE=5

# Vercel sends this token to scheduled endpoints as Authorization: Bearer.
CRON_SECRET=generate_a_random_secret_at_least_16_characters

# Server-side only. Never expose this key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key_here

# Cookie signing and browser access.
SESSION_SECRET=generate_a_long_random_secret
CORS_ALLOWED_ORIGINS=https://your-production-domain.example

# Disabled by default. Only use temporarily while migrating away from a shared login.
ALLOW_LEGACY_ADMIN_LOGIN=0
ADMIN_EMAIL=
ADMIN_PASSWORD=
